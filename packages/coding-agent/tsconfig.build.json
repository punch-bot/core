{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@punch-bot/agent": ["../agent/dist/index.d.ts"],
			"@punch-bot/agent/*": ["../agent/dist/*.d.ts"],
			"@punch-bot/ai": ["../ai/dist/index.d.ts"],
			"@punch-bot/ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@punch-bot/client": ["../client/dist/index.d.ts"],
			"@punch-bot/protocol": ["../protocol/dist/index.d.ts"],
			"@punch-bot/tui": ["../tui/dist/index.d.ts"],
			"@punch-bot/tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
