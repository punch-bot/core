{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@punch-bot/chord": ["./packages/chord/src/index.ts"],
			"@punch-bot/chord/context": ["./packages/chord/src/context/index.ts"],
			"@punch-bot/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@punch-bot/chord/node": ["./packages/chord/src/node.ts"],
			"@punch-bot/chord/output": ["./packages/chord/src/output.ts"],
			"@punch-bot/chord/telemetry-sqlite": ["./packages/chord/src/telemetry-sqlite/index.ts"],
			"@punch-bot/chord/sqlite": ["./packages/chord/src/sqlite/index.ts"],
			"@punch-bot/chord/sqlite/node": ["./packages/chord/src/sqlite/node.ts"],
			"@punch-bot/chord/sqlite/cloudflare": ["./packages/chord/src/sqlite/cloudflare.ts"],
			"@punch-bot/telemetry": ["./packages/telemetry/src/index.ts"],
			"@punch-bot/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@punch-bot/telemetry/render": ["./packages/telemetry/src/render.ts"],
			"@punch-bot/codemode": ["./packages/codemode/src/index.ts"],
			"@punch-bot/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@punch-bot/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@punch-bot/codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@punch-bot/codemode/source": ["./packages/codemode/src/source.ts"],
			"@punch-bot/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@punch-bot/mcp": ["./packages/mcp/src/index.ts"],
			"@punch-bot/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@punch-bot/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@punch-bot/ai": ["./packages/ai/src/index.ts"],
			"@punch-bot/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@punch-bot/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@punch-bot/ai/dist/*": ["./packages/ai/src/*"],
			"@punch-bot/durable": ["./packages/durable/src/index.ts"],
			"@punch-bot/durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@punch-bot/durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@punch-bot/env": ["./packages/env/src/index.ts"],
			"@punch-bot/agent": ["./packages/agent/src/index.ts"],
			"@punch-bot/a2a": ["./packages/a2a/src/index.ts"],
			"@punch-bot/a2a/*": ["./packages/a2a/src/*"],
			"@punch-bot/cli": ["./packages/coding-agent/src/index.ts"],
			"@punch-bot/cli/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@punch-bot/cli/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/durable/test-workers/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
