{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@punch-bot/telemetry": ["./packages/telemetry/src/index.ts"],
			"@punch-bot/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@punch-bot/ai": ["./packages/ai/src/index.ts"],
			"@punch-bot/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@punch-bot/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@punch-bot/ai/dist/*": ["./packages/ai/src/*"],
			"@punch-bot/agent": ["./packages/agent/src/index.ts"],
			"@punch-bot/agent/node": ["./packages/agent/src/node.ts"],
			"@punch-bot/agent/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@punch-bot/agent/*": ["./packages/agent/src/*"],
			"@punch-bot/sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@punch-bot/cli": ["./packages/coding-agent/src/index.ts"],
			"@punch-bot/cli/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@punch-bot/cli/*": ["./packages/coding-agent/src/*"],
			"@punch-bot/protocol": ["./packages/protocol/src/index.ts"],
			"@punch-bot/protocol/*": ["./packages/protocol/src/*"],
			"@punch-bot/client": ["./packages/client/src/index.ts"],
			"@punch-bot/client/*": ["./packages/client/src/*"],
			"@punch-bot/server": ["./packages/server/src/index.ts"],
			"@punch-bot/server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@punch-bot/tui": ["./packages/tui/src/index.ts"],
			"@punch-bot/tui/*": ["./packages/tui/src/*"],
			"@earendil-works/pi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@earendil-works/pi-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
